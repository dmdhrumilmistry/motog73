#
# Kernel fragment for running postmarketOS (or another GNU/Linux userspace)
# on the moto g73 5G with Motorola's downstream 5.10 kernel.
# Merged by: kernel/build-kernel.sh -p
#
# After building, verify with:
#   pmbootstrap kconfig check linux-motorola-devonf
# and add anything it reports as missing here.
#

# Identify the build
CONFIG_LOCALVERSION="-postmarketos"

# --- Required by postmarketOS initramfs / systemd / OpenRC ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_MEMCG=y
CONFIG_BPF_SYSCALL=y
CONFIG_USER_NS=y
CONFIG_NAMESPACES=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_UNIX=y
CONFIG_BINFMT_MISC=y

# --- Console on the display (useful during bring-up) ---
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# MediaTek's DRM fbdev glue (mediatek_v2/mtk_drm_fbdev.c) does not compile in
# this tree, so no fbdev emulation / framebuffer console. Display is driven
# through DRM (Phosh, unl0kr); use SSH over USB or the serial getty to debug.
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# --- Storage / root filesystem ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_VFAT_FS=y
CONFIG_DM_CRYPT=y
CONFIG_BLK_DEV_LOOP=y

# --- USB networking for SSH over USB during bring-up ---
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y

# --- Networking used by NetworkManager / ModemManager / firewall ---
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_TUN=y
CONFIG_WIREGUARD=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y

# --- Android-specific options that confuse a regular Linux userspace ---
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# --- Build: no LTO / CFI, no -Werror ---
# postmarketOS does not load the stock GKI vendor modules, so the CFI/LTO
# ABI constraints they impose are not needed. Disabling them gives faster
# builds with far less RAM, and avoids breakage with the newer distro clang.
# (LTO_CLANG is a hidden symbol selected by the LTO choice; LTO_NONE suffices.)
# CONFIG_WERROR is not set
CONFIG_LTO_NONE=y
# CONFIG_CFI_CLANG is not set
