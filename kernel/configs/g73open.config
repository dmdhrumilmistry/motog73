#
# Kernel fragment for the "G73 Open" custom ROM flavor.
# Merged on top of Motorola's devonf configuration by
#   kernel/build-kernel.sh -g
#
# Keep this small: every option here must stay compatible with the
# stock vendor_boot / vendor_dlkm modules (GKI KMI), otherwise modules
# built by Motorola will refuse to load.
#

# Identify custom builds in `uname -r`
CONFIG_LOCALVERSION="-g73open"
# CONFIG_LOCALVERSION_AUTO is not set
