# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config: generated by kernel/build-kernel.sh -p -k in
# https://github.com/dmdhrumilmistry/motog73 from
#   gki_defconfig + mgk_64_k510_defconfig + Motorola devonf overlays
#   + kernel/configs/postmarketos.config
pkgname=linux-motorola-devonf
pkgver=5.10.240
pkgrel=0
pkgdesc="Motorola moto g73 5G kernel (Motorola open source release)"
arch="aarch64"
_carch="arm64"
_flavor="motorola-devonf"
url="https://github.com/MotorolaMobilityLLC/kernel-mtk"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	clang
	devicepkg-dev
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	perl
	python3
	xz
"

# Source: Motorola release matching stock build U1TNS34.82-12-7-26
_tag="MMI-U1TNS34.82-12-7-26"
_config="config-$_flavor.$CARCH"
source="
	$pkgname-$_tag.tar.gz::https://github.com/MotorolaMobilityLLC/kernel-mtk/archive/refs/tags/$_tag.tar.gz
	$_config
"
builddir="$srcdir/kernel-mtk-$_tag"

# The source targets AOSP clang 12. Newer clang releases add warnings that
# MediaTek's drivers turn into errors with -Werror; downgrade them.
_kcflags="
	-Wno-error=bitwise-instead-of-logical
	-Wno-error=unused-but-set-variable
	-Wno-error=unused-but-set-parameter
	-Wno-error=deprecated-non-prototype
	-Wno-error=strict-prototypes
	-Wno-error=single-bit-bitfield-constant-conversion
	-Wno-error=array-parameter
	-Wno-error=gnu-variable-sized-type-not-at-end
	-Wno-error=unused-function
	-Wno-error=unused-variable
	-Wno-error=format
"

_make() {
	make ARCH="$_carch" LLVM=1 LLVM_IAS=1 \
		KCFLAGS="$(echo $_kcflags)" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor" \
		"$@"
}

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
	_make olddefconfig
}

build() {
	unset LDFLAGS
	_make Image.gz modules mediatek/mt6855.dtb
}

package() {
	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
		"$pkgdir/boot/vmlinuz"

	install -Dm644 "$builddir/arch/$_carch/boot/dts/mediatek/mt6855.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt6855.dtb"

	_make modules_install \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1

	# "build" / "source" would point at the build host
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -Dm644 "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

# The tarball checksum is filled in by `pmbootstrap checksum linux-motorola-devonf`
sha512sums="
RUN_PMBOOTSTRAP_CHECKSUM  linux-motorola-devonf-MMI-U1TNS34.82-12-7-26.tar.gz
4ce8556c76c6f81250539c463757b3f0aab493a565a379ee888e44b53923924bfcc4dab9edb8898ea769b9b902c22eda6787d8294732576256b41e3004fae90f  config-motorola-devonf.aarch64
"
