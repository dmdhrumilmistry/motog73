# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config: generated by kernel/build-kernel.sh -p -k in
# https://github.com/dmdhrumilmistry/motog73 from
#   gki_defconfig + mgk_64_k510_defconfig + Motorola devonf overlays
#   + kernel/configs/postmarketos.config
# abuild requires a maintainer with a valid email address
maintainer="dmdhrumilmistry <56185972+dmdhrumilmistry@users.noreply.github.com>"
pkgname=linux-motorola-devonf
pkgver=5.10.240
pkgrel=0
pkgdesc="Motorola moto g73 5G kernel (Motorola open source release)"
arch="aarch64"
_carch="arm64"
_flavor="motorola-devonf"
url="https://github.com/MotorolaMobilityLLC/kernel-mtk"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	clang
	devicepkg-dev
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	perl
	python3
	xz
"

# Source: Motorola release matching stock build U1TNS34.82-12-7-26
_tag="MMI-U1TNS34.82-12-7-26"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_tag.tar.gz::https://github.com/MotorolaMobilityLLC/kernel-mtk/archive/refs/tags/$_tag.tar.gz
	$_config
"
builddir="$srcdir/kernel-mtk-$_tag"

export LLVM=1
export LLVM_IAS=1
export CC="clang"
export HOSTCC="clang"

# Install Image.gz rather than the uncompressed Image
export KERNEL_IMAGE_NAME="Image.gz"

_outdir="out"

prepare() {
	default_prepare
	# 5.10 already ships a working include/linux/compiler-gcc.h
	REPLACE_GCCH=0 . downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" LLVM=1 LLVM_IAS=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS" \
		Image.gz modules mediatek/mt6855.dtb
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	make O="$_outdir" ARCH="$_carch" LLVM=1 LLVM_IAS=1 \
		modules_install \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1

	# "build" / "source" would point at the build host
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -Dm644 "$builddir/$_outdir/arch/$_carch/boot/dts/mediatek/mt6855.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt6855.dtb"
}

# The tarball checksum is filled in by `pmbootstrap checksum linux-motorola-devonf`
sha512sums="
RUN_PMBOOTSTRAP_CHECKSUM  linux-motorola-devonf-MMI-U1TNS34.82-12-7-26.tar.gz
7d096dac69b5b351801672bf575d9d9557b4b993686314dd261b58bb1ca66246925533ce0ef37d070b98ec1020c43d57d998f628f6197a3ce2946d3eb9d01047  config-motorola-devonf.aarch64
"
