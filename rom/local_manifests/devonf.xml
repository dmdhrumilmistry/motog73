<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for building LineageOS 24.0 (+ the G73 Open flavor) for the
  moto g73 5G (devonf). Copy into <lineage-source>/.repo/local_manifests/
  (rom/build-rom.sh does this for you), then `repo sync`.

  Device support comes from the community LineageOS-based trees maintained
  by the devonf community (MistOS-Devices, kjdev16, sreejith7676, yaap).
  Credit and thanks to them. See CREDITS.md.

  Deliberately NOT included: the upstream tree's private signing-key
  repository. Generate your own keys with rom/gen-keys.sh.
-->
<manifest>
  <remote name="github-devonf" fetch="https://github.com/" />

  <!-- Device tree, prebuilt kernel and proprietary vendor files -->
  <project path="device/motorola/devonf" name="MistOS-Devices/device_motorola_devonf" remote="github-devonf" revision="17" />
  <project path="device/motorola/devonf-kernel" name="kjdev16/device_motorola_devonf-kernel" remote="github-devonf" revision="sixteen" clone-depth="1" />
  <project path="vendor/motorola/devonf" name="kjdev16/vendor_motorola_devonf" remote="github-devonf" revision="seventeen" clone-depth="1" />
  <project path="vendor/motorola/devonf-motcamera" name="sreejith7676/vendor_motorola_devonf-motcamera" remote="github-devonf" revision="16" clone-depth="1" />

  <!-- MediaTek platform support -->
  <project path="hardware/mediatek" name="kjdev16/hardware_mediatek" remote="github-devonf" revision="seventeen" />
  <project path="device/mediatek/sepolicy_vndr" name="yaap/device_mediatek_sepolicy_vndr" remote="github-devonf" revision="seventeen" />

  <!-- Forks with devonf / MediaTek fixes, replacing the LineageOS defaults -->
  <remove-project name="LineageOS/android_hardware_google_pixel" optional="true" />
  <project path="hardware/google/pixel" name="kjdev16/hardware_google_pixel" remote="github-devonf" revision="17.0" />
  <remove-project name="LineageOS/android_hardware_lineage_interfaces" optional="true" />
  <project path="hardware/lineage/interfaces" name="kjdev16/android_hardware_lineage_interfaces" remote="github-devonf" revision="lineage-24.0" />
  <remove-project name="LineageOS/android_packages_modules_Bluetooth" optional="true" />
  <project path="packages/modules/Bluetooth" name="kjdev16/packages_modules_Bluetooth" remote="github-devonf" revision="17.0" />
</manifest>
